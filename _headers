# Cloudflare Pages _headers file
# Security and caching headers for allsoft.asia

/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-XSS-Protection: 1; mode=block
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

# CSS/JS caching (1 year, use ?v= for cache-busting on updates)
/*.css
  Cache-Control: public, max-age=31536000

/*.js
  Cache-Control: public, max-age=31536000

# Images caching (1 year)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# HTML - shorter cache for content updates
/*.html
  Cache-Control: public, max-age=3600, must-revalidate

# Sitemap and robots
/sitemap.xml
  Cache-Control: public, max-age=86400

/robots.txt
  Cache-Control: public, max-age=86400

# Allow iframe for chat page (chathub.asia embed)
/chat.html
  X-Frame-Options: SAMEORIGIN
